{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "utils/**",
        "routes/**",
        "models/**",
        "middleware/**"
      ]
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}